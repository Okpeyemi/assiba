# Vercel Postgres — auto-injecté par Vercel quand vous liez une DB Postgres
POSTGRES_URL=

# Secret partagé entre VAPI et votre webhook (chaîne aléatoire)
VAPI_WEBHOOK_SECRET=

# Rempli automatiquement par vapi/setup.js après la première exécution
VAPI_ASSISTANT_ID=

# Utilisé uniquement par vapi/setup.js (pas besoin en production Vercel)
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
WEBHOOK_URL=https://your-project.vercel.app
OWNER_NAME=Jean Dupont
