{
  "expo": {
    "name": "Assiba",
    "slug": "assiba",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.assiba.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Assiba n'utilise pas le microphone."
      }
    },
    "android": {
      "package": "com.assiba.app",
      "adaptiveIcon": {
        "backgroundColor": "#6200EE",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9de16f59-0149-4ac0-b7e5-2217b85b6ded"
      }
    },
    "owner": "okpeyemi"
  }
}
